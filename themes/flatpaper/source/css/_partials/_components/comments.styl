/* ============== COMMENTS ============== */
/* Wrapper card around the mounted comment system (Twikoo / Artalk),
   rendered by _partial/comments.ejs below the article inside .paper-main.
   Mirrors the paper-card treatment from shell.styl. */
.comments-section {
  position: relative;
  padding: 26px 30px;
  z-index: 1;
}

.comments-section::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--paper);
  z-index: -1;
  border-radius: 4px;
  filter: url(#paper-edge) drop-shadow(0 2px 6px rgba(0,0,0,0.06));
}

.comments-section::after {
  content: "";
  position: absolute;
  top: -12px;
  left: 50%;
  z-index: 2;
  width: 90px;
  height: 22px;
  background-color: var(--tape-pink);
  background-image: var(--tape-stripes);
  transform: translateX(-50%) rotate(-2deg);
}

.comments-section__head h2 {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 18px;
  font-size: 18px;
  font-weight: 700;
}

.comments-section__head h2 .lucide {
  width: 18px;
  height: 18px;
  color: var(--color-accent);
}

.dark-mode .comments-section__head h2 .lucide {
  color: var(--color-accent-muted);
}

/* ============== ARTALK DARK MODE ============== */
.dark-mode .atk {
  --at-color-bg: var(--paper);
  --at-color-bg-secondary: var(--paper-warm);
  --at-color-bg-hover: var(--line);
  --at-color-text: var(--ink);
  --at-color-text-secondary: var(--ink-soft);
  --at-color-text-3: var(--muted);
  --at-color-border: var(--line);
  --at-color-border-hover: var(--color-accent-muted);
  --at-color-active: var(--color-accent-strong);
  --at-color-link: var(--color-accent-muted);
}

.dark-mode #artalk-comments .atk-editor {
  background: var(--paper);
  border-color: var(--line);
}

.dark-mode #artalk-comments .atk-editor .atk-input {
  background: var(--paper);
  color: var(--ink);
}

.dark-mode #artalk-comments .atk-editor textarea {
  background: var(--paper);
  color: var(--ink);
}

.dark-mode #artalk-comments .atk-text {
  color: var(--ink-soft);
}

.dark-mode #artalk-comments .atk-text .atk-comment-count-num {
  color: var(--ink);
}

.dark-mode #artalk-comments .atk-dropdown {
  background: var(--paper);
  border-color: var(--line);
}

.dark-mode #artalk-comments .atk-dropdown .atk-dropdown-item {
  color: var(--ink);
}

.dark-mode #artalk-comments .atk-dropdown .atk-dropdown-item:hover {
  background: var(--line);
  color: var(--color-accent-strong);
}

.dark-mode #artalk-comments .atk-comment {
  border-color: var(--line);
}

.dark-mode #artalk-comments .atk-comment .atk-content {
  color: var(--ink-soft);
}

.dark-mode #artalk-comments .atk-nick {
  color: var(--color-accent-muted);
}

.dark-mode #artalk-comments .atk-badge {
  background: var(--color-accent-strong);
  color: #fff;
}

.dark-mode #artalk-comments .atk-action .atk-btn {
  color: var(--muted);
}

.dark-mode #artalk-comments .atk-action .atk-btn:hover {
  color: var(--color-accent-muted);
}

.dark-mode #artalk-comments .atk-bottom {
  color: var(--muted);
}

.dark-mode #artalk-comments .atk-btn-send {
  background: var(--color-accent);
  color: #fff;
}

.dark-mode #artalk-comments .atk-btn-send:hover {
  background: var(--color-accent-strong);
}
